# =============================================================================
# CODEMANIAC STUDIO — ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env for local development or configure in your hosting Secrets panel.
# Never commit real secrets to version control.
# =============================================================================

# --- Runtime & Hosting ---
PORT=3000
NODE_ENV=development
APP_URL="MY_APP_URL"

# --- AI Studio / Gemini (Optional) ---
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Codemaniac Studio Admin Portal (/admin) ---
# Optional server-side password override for /admin.
# If left empty, complete the one-time First-Run Admin Setup form in /admin.
STUDIO_ADMIN_PASSWORD=

# --- Database (SQLite Preview vs Production PostgreSQL / Supabase) ---
SAAS_DB_PATH="./data/saas.db"
RESTOFLOW_DB_PATH="./data/restoflow.db"
EDUMANAGE_DB_PATH="./data/edumanage.db"
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payment Gateways (Server-Only Secrets) ---
# Configuring STRIPE_SECRET_KEY or RAZORPAY_KEY_ID activates live gateway status in /saas Billing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Transactional Email (SMTP for Password Resets & Invitations) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Codemaniac Studio <noreply@codemaniac.studio>"

